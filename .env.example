# ===========================================
# EP Energy Platform — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# ---- Database (Railway auto-provides MYSQL_URL) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=energy_platform

# ---- JWT ----
JWT_SECRET=your_super_secret_jwt_key_change_me

# ---- App URL ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- SMTP / Email ----
SMTP_HOST=hostde44.fornex.host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vertreter@empire-premium-bau.de
SMTP_PASS=your_smtp_password
SMTP_FROM=vertreter@empire-premium-bau.de
